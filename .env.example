# Your Courier API key, from https://app.courier.com/settings/api-keys
# Copy this file to .env and paste your key in.
# A Test key is fine — the inbox channel delivers in Test.
#
# No PUBLIC_ prefix: Astro inlines PUBLIC_ variables into the browser bundle,
# and this key must stay on the server.
COURIER_API_KEY=YOUR_COURIER_API_KEY
